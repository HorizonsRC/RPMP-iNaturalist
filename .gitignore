# ============================================================================
# .gitignore — files that should NEVER be uploaded to GitHub
# ============================================================================
 
# --- Sensitive config (contains passwords and API keys) ---
config.py
 
# --- iNaturalist OAuth token (contains your personal access token) ---
inat_token.json
 
# --- Log files (large, machine-specific, not useful on GitHub) ---
Logs/
*.log
 
# --- Claude Code guidance file (local context, not for the repo) ---
CLAUDE.md

# --- Generated dashboard data (published to the gh-pages branch, not main) ---
dashboard_data.json

# --- Python cache files (auto-generated, not needed) ---
__pycache__/
*.py[cod]
*.pyo

# --- Jupyter notebook checkpoints (auto-generated) ---
.ipynb_checkpoints/

# --- IDE / editor workspace files (machine-specific) ---
VS-code-workspace/
*.code-workspace

# --- Local output from extract_uncategorized.py ---
uncategorized_observations*.csv

# --- HTML design previews / work-in-progress (don't publish via Pages) ---
html/*_preview.html

# --- OS junk files ---
.DS_Store
Thumbs.db

# --- Virtual environment (if you ever create one) ---
venv/
.env

# --- Local working folders (not part of the repo) ---
Archive/
Temp/
png/
iNat API/
Pest Plant Projects List NZ/
RPMP_iNat_Dashboard/
